{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:console:sprint:v0",
  "title": "Console SprintSpec v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sprint_id",
    "revision",
    "plan_version",
    "registration_state",
    "target",
    "title",
    "track",
    "schedule",
    "delegation",
    "limits",
    "human_validation",
    "sources",
    "unresolved_bindings",
    "exit_condition",
    "tasks",
    "digest",
    "contract_revision"
  ],
  "properties": {
    "schema_version": {
      "const": "console.sprint.v0"
    },
    "sprint_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "plan_version": {
      "type": "string",
      "minLength": 1
    },
    "registration_state": {
      "enum": [
        "draft",
        "ready"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo_id",
        "repository_url"
      ],
      "properties": {
        "repo_id": {
          "type": "string",
          "minLength": 1
        },
        "repository_url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "track": {
      "enum": [
        "핵심",
        "확장",
        "종합"
      ]
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timezone",
        "planned_start_at",
        "deadline_at",
        "entry_condition",
        "unresolved_reason",
        "deadline_state"
      ],
      "properties": {
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "planned_start_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "deadline_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "entry_condition": {
          "type": "string",
          "minLength": 1
        },
        "unresolved_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "deadline_state": {
          "enum": [
            "set",
            "none",
            "undecided"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "deadline_state": {
                "const": "set"
              }
            }
          },
          "then": {
            "properties": {
              "deadline_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "else": {
            "properties": {
              "deadline_at": {
                "type": "null"
              },
              "unresolved_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "forbidden",
        "approval_scope_ref"
      ],
      "properties": {
        "allowed": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "approval_scope_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elapsed_seconds",
        "total_tokens",
        "correction_attempts",
        "unresolved_reason"
      ],
      "properties": {
        "elapsed_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "total_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "correction_attempts": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "unresolved_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "human_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "timing",
        "criteria_ref"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "timing": {
          "type": "string",
          "minLength": 1
        },
        "criteria_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "ref",
          "revision",
          "digest",
          "observed_at"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "observed_at": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "unresolved_bindings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "exit_condition": {
      "type": "string",
      "minLength": 1
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "kind",
          "requirement_ids",
          "prerequisites",
          "outputs",
          "verification",
          "acceptance",
          "exit_condition",
          "references",
          "legacy_v1_2_id",
          "status",
          "evidence",
          "estimate"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^\\d{2}-\\d{2}$"
          },
          "kind": {
            "enum": [
              "설계",
              "준비",
              "구현",
              "검증",
              "연결 검수",
              "평가",
              "종합"
            ]
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "task_id",
                "plan_version",
                "required_state"
              ],
              "properties": {
                "task_id": {
                  "type": "string",
                  "minLength": 1
                },
                "plan_version": {
                  "type": "string",
                  "minLength": 1
                },
                "required_state": {
                  "enum": [
                    "accepted",
                    "result_recorded"
                  ]
                }
              }
            }
          },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "artifact_id",
                "description",
                "required"
              ],
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "required": {
                  "type": "boolean"
                }
              }
            }
          },
          "verification": {
            "type": "string",
            "minLength": 1
          },
          "acceptance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "profile_id",
              "profile_revision",
              "item_ids",
              "criteria"
            ],
            "properties": {
              "profile_id": {
                "type": "string",
                "minLength": 1
              },
              "profile_revision": {
                "type": "integer",
                "minimum": 1
              },
              "item_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "criteria": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "exit_condition": {
            "type": "string",
            "minLength": 1
          },
          "references": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "legacy_v1_2_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "미착수",
              "준비됨",
              "진행",
              "검수 중",
              "검수 완료",
              "조건 대기",
              "종료 미충족"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "estimate": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "range_seconds",
              "evidence",
              "reason"
            ],
            "properties": {
              "state": {
                "enum": [
                  "measured",
                  "unestimated"
                ]
              },
              "range_seconds": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "min",
                      "max"
                    ],
                    "properties": {
                      "min": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "max": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "state": {
                      "const": "measured"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "range_seconds": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "min",
                        "max"
                      ],
                      "properties": {
                        "min": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "max": {
                          "type": "integer",
                          "minimum": 1
                        }
                      }
                    },
                    "evidence": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1
                    }
                  }
                },
                "else": {
                  "properties": {
                    "range_seconds": {
                      "type": "null"
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "contract_revision": {
      "const": 4
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "registration_state": {
            "const": "ready"
          }
        }
      },
      "then": {
        "properties": {
          "target": {
            "properties": {
              "repository_url": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "limits": {
            "properties": {
              "elapsed_seconds": {
                "type": "integer",
                "minimum": 1
              },
              "total_tokens": {
                "type": "integer",
                "minimum": 1
              },
              "correction_attempts": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "unresolved_bindings": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
