{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Console ProgressReport v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_revision",
    "sprint_id",
    "sprint_revision",
    "task_id",
    "repo_id",
    "assignment_id",
    "generation",
    "actor",
    "observed_at",
    "channel",
    "evidence_level",
    "phase",
    "operational_state",
    "reason_code",
    "evidence",
    "unknown_facts",
    "affected_tasks",
    "next_action",
    "next_owner",
    "resume_condition",
    "next_check_at",
    "decision",
    "contract_revision",
    "report_type",
    "body",
    "schedule"
  ],
  "properties": {
    "schema_version": {
      "const": "console.report.v0"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_revision": {
      "type": "integer",
      "minimum": 1
    },
    "sprint_id": {
      "type": "string",
      "minLength": 1
    },
    "sprint_revision": {
      "type": "integer",
      "minimum": 1
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "repo_id": {
      "type": "string",
      "minLength": 1
    },
    "assignment_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "generation": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "name"
      ],
      "properties": {
        "role": {
          "enum": [
            "development",
            "guardrail",
            "coordinator"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "channel": {
      "enum": [
        "agent_to_coordinator",
        "coordinator_to_client"
      ]
    },
    "evidence_level": {
      "enum": [
        "claim",
        "verified"
      ]
    },
    "phase": {
      "enum": [
        "접수",
        "선행 확인",
        "설계 검토",
        "개발",
        "내부 검사",
        "독립 검토",
        "교정",
        "병합",
        "main CI",
        "후속 처분",
        "보고"
      ]
    },
    "operational_state": {
      "enum": [
        "작업 중",
        "작업을 보유한 대기",
        "사람 결정 대기",
        "일 없음",
        "실패",
        "완료"
      ]
    },
    "reason_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unknown_facts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "affected_tasks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "next_owner": {
      "type": "string",
      "minLength": 1
    },
    "resume_condition": {
      "type": [
        "string",
        "null"
      ]
    },
    "next_check_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "decision": {
      "type": "object",
      "required": [
        "required",
        "question",
        "options",
        "recommendation",
        "deadline_at",
        "default_action"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "question": {
          "type": [
            "string",
            "null"
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "recommendation": {
          "type": [
            "string",
            "null"
          ]
        },
        "deadline_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "default_action": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "contract_revision": {
      "const": 4
    },
    "report_type": {
      "enum": [
        "development_progress",
        "guardrail_review",
        "coordinator_verdict",
        "decision_request"
      ]
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deadline_state",
        "deadline_at",
        "status",
        "remaining_tasks",
        "remaining_reason",
        "delay_reasons",
        "affected_tasks",
        "forecast"
      ],
      "properties": {
        "deadline_state": {
          "enum": [
            "set",
            "none",
            "undecided"
          ]
        },
        "deadline_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "on_track",
            "at_risk",
            "late",
            "no_deadline",
            "unassessed"
          ]
        },
        "remaining_tasks": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "remaining_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "delay_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "affected_tasks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forecast": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "completion_range",
            "evidence",
            "reason"
          ],
          "properties": {
            "state": {
              "enum": [
                "estimated",
                "unestimated"
              ]
            },
            "completion_range": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "earliest_at",
                    "latest_at"
                  ],
                  "properties": {
                    "earliest_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "latest_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "state": {
                    "const": "estimated"
                  }
                }
              },
              "then": {
                "properties": {
                  "completion_range": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "earliest_at",
                      "latest_at"
                    ],
                    "properties": {
                      "earliest_at": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "latest_at": {
                        "type": "string",
                        "format": "date-time"
                      }
                    }
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  }
                }
              },
              "else": {
                "properties": {
                  "completion_range": {
                    "type": "null"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "deadline_state": {
                "const": "set"
              }
            }
          },
          "then": {
            "properties": {
              "deadline_at": {
                "type": "string",
                "format": "date-time"
              },
              "status": {
                "enum": [
                  "on_track",
                  "at_risk",
                  "late",
                  "unassessed"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "deadline_state": {
                "const": "none"
              }
            }
          },
          "then": {
            "properties": {
              "deadline_at": {
                "type": "null"
              },
              "status": {
                "const": "no_deadline"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "deadline_state": {
                "const": "undecided"
              }
            }
          },
          "then": {
            "properties": {
              "deadline_at": {
                "type": "null"
              },
              "status": {
                "const": "unassessed"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "at_risk",
                  "late"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "delay_reasons": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "affected_tasks": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "remaining_tasks": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "remaining_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "body": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "channel": {
            "const": "agent_to_coordinator"
          }
        }
      },
      "then": {
        "properties": {
          "evidence_level": {
            "const": "claim"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "channel": {
            "const": "coordinator_to_client"
          }
        }
      },
      "then": {
        "properties": {
          "evidence_level": {
            "const": "verified"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operational_state": {
            "const": "작업을 보유한 대기"
          }
        }
      },
      "then": {
        "properties": {
          "reason_code": {
            "type": "string",
            "minLength": 1
          },
          "assignment_id": {
            "type": "string",
            "minLength": 1
          },
          "next_check_at": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "report_type": {
            "const": "development_progress"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage",
              "change_summary",
              "target_sha",
              "sha_unavailable_reason",
              "internal_checks",
              "blocked_reason"
            ],
            "properties": {
              "stage": {
                "type": "string",
                "minLength": 1
              },
              "change_summary": {
                "type": "string",
                "minLength": 1
              },
              "target_sha": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{40,64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sha_unavailable_reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "internal_checks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "result",
                    "evidence"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "result": {
                      "enum": [
                        "PASS",
                        "FAIL",
                        "INCONCLUSIVE",
                        "NOT_RUN"
                      ]
                    },
                    "evidence": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              },
              "blocked_reason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "target_sha": {
                      "type": "null"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "sha_unavailable_reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            ]
          },
          "actor": {
            "properties": {
              "role": {
                "const": "development"
              }
            }
          },
          "channel": {
            "const": "agent_to_coordinator"
          },
          "evidence_level": {
            "const": "claim"
          },
          "decision": {
            "properties": {
              "required": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "report_type": {
            "const": "guardrail_review"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "verdict",
              "target_sha",
              "findings"
            ],
            "properties": {
              "verdict": {
                "enum": [
                  "approve",
                  "reject",
                  "needs_confirmation"
                ]
              },
              "target_sha": {
                "type": "string",
                "pattern": "^[a-f0-9]{40,64}$"
              },
              "findings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "finding_id",
                    "violated_condition",
                    "reproduction",
                    "expected",
                    "actual",
                    "severity",
                    "confidence",
                    "original_log_ref"
                  ],
                  "properties": {
                    "finding_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "violated_condition": {
                      "type": "string",
                      "minLength": 1
                    },
                    "reproduction": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "command",
                        "input"
                      ],
                      "properties": {
                        "command": {
                          "type": "string",
                          "minLength": 1
                        },
                        "input": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "expected": {
                      "type": "string",
                      "minLength": 1
                    },
                    "actual": {
                      "type": "string",
                      "minLength": 1
                    },
                    "severity": {
                      "enum": [
                        "P0",
                        "P1",
                        "P2",
                        "P3"
                      ]
                    },
                    "confidence": {
                      "enum": [
                        "reproduced",
                        "supported",
                        "unconfirmed"
                      ]
                    },
                    "original_log_ref": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          "actor": {
            "properties": {
              "role": {
                "const": "guardrail"
              }
            }
          },
          "channel": {
            "const": "agent_to_coordinator"
          },
          "evidence_level": {
            "const": "claim"
          },
          "decision": {
            "properties": {
              "required": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "report_type": {
            "const": "coordinator_verdict"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidence_comparison",
              "affected_tasks",
              "next_owner"
            ],
            "properties": {
              "evidence_comparison": {
                "type": "string",
                "minLength": 1
              },
              "affected_tasks": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "next_owner": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "actor": {
            "properties": {
              "role": {
                "const": "coordinator"
              }
            }
          },
          "channel": {
            "const": "coordinator_to_client"
          },
          "evidence_level": {
            "const": "verified"
          },
          "decision": {
            "properties": {
              "required": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "report_type": {
            "const": "decision_request"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question",
              "options",
              "recommendation",
              "rationale",
              "deadline_at",
              "no_deadline_reason",
              "default_action"
            ],
            "properties": {
              "question": {
                "type": "string",
                "minLength": 1
              },
              "options": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "label",
                    "impact"
                  ],
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "impact": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "recommendation": {
                "type": "string",
                "minLength": 1
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "deadline_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "no_deadline_reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "default_action": {
                "type": "string",
                "minLength": 1
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "deadline_at": {
                      "type": "null"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "no_deadline_reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            ]
          },
          "actor": {
            "properties": {
              "role": {
                "const": "coordinator"
              }
            }
          },
          "channel": {
            "const": "coordinator_to_client"
          },
          "evidence_level": {
            "const": "verified"
          },
          "decision": {
            "properties": {
              "required": {
                "const": true
              }
            }
          }
        }
      }
    }
  ]
}
